{
  "name": "purrrfect-keys",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --testPathPattern='performance/' --verbose --no-coverage",
    "test:security": "jest --testPathPattern='security/' --verbose --no-coverage",
    "test:regression": "jest --testPathPattern='regression/' --verbose --no-coverage",
    "test:stress": "jest --testPathPattern='stress/' --verbose --no-coverage",
    "test:qa": "jest --testPathPattern='(performance|security|regression|stress)/' --verbose --no-coverage",
    "audit:security": "npm audit --omit=dev",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "e2e:build:ios": "detox build -c ios.sim.debug",
    "e2e:test:ios": "detox test -c ios.sim.debug --cleanup",
    "e2e:test:ios:headless": "detox test -c ios.sim.debug --cleanup --headless",
    "validate:exercises": "ts-node scripts/validate-exercises.ts",
    "generate:exercise": "ts-node scripts/generate-exercise.ts",
    "measure:latency": "ts-node scripts/measure-latency.ts",
    "build:dev": "eas build --profile development-device --platform ios",
    "build:dev:sim": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:preview:sim": "eas build --profile preview-simulator --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform ios",
    "build:local-release": "npx expo run:ios --configuration Release",
    "maestro:smoke": "maestro test .maestro/flows/01-smoke-test.yaml",
    "maestro:all": "maestro test .maestro/flows/",
    "maestro:critical": "maestro test --include-tags=critical .maestro/flows/"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@motiz88/react-native-midi": "^0.0.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.14.5",
    "@sentry/react-native": "~6.14.0",
    "@shopify/react-native-skia": "^2.5.2",
    "abcjs": "^6.6.2",
    "expo": "~53",
    "expo-apple-authentication": "~7.2.4",
    "expo-asset": "~11.1.7",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.8",
    "expo-contacts": "~14.2.6",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-screen-orientation": "~8.1.7",
    "expo-sharing": "~13.1.5",
    "expo-speech": "~13.1.7",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "firebase": "^12.9.0",
    "onnxruntime-react-native": "^1.24.3",
    "posthog-react-native": "^4.37.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-audio-api": "^0.11.7",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-view-shot": "~4.0.3",
    "react-native-web": "^0.20.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "~13",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.47.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^13.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "fast-xml-parser": ">=5.5.6"
  }
}
